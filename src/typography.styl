@require "mixins/dimension"
@require "mixins/typography"

// default font
:root
  --copy-font var(--base-font)
  --heading-font var(--base-font)
  font-family var(--copy-font)
  font-size var(--copy-font-size, 1rem)
  line-height var(--copy-line-height, 1.5rem)

h1, h2, h3, h4, h5, h6
  font-weight bold
  font-family var(--heading-font, var(--base-font))

i
  margin-right 0.25rem

h1
  color var(--h1-color)
  text-transform capitalize

h2, h3, h4, h5, h6
  color var(--h2-h6-color)

h1
  font-size var(--first-level-heading-font-size)
  line-height var(--first-level-heading-line-height)
h2
  font-size var(--second-level-heading-font-size)
  line-height var(--second-level-heading-line-height)
h3
  font-size var(--third-level-heading-font-size)
  line-height var(--third-level-heading-line-height)

// main, form
//   container-type inline-size

article, .copy

  section, header, footer
    padding-inline 1rem

  .rule
    padding-block-end 1rem
    border-bottom 1px solid var(--accent)

  header
    p
      --copy-font-size var(--large-copy-font-size)
      --copy-line-height var(--large-copy-line-height)
      font-style italic

article, .copy, :is(article, .copy) :is(section, header, footer)

    max-width var(--copy-max-width)
    min-width var(--copy-min-width)
    
    display flex
    flex-direction column
    gap 1rem

    color var(--foreground)
    font-family var(--copy-font, var(--base-font))
    font-size var(--copy-font-size, 1rem)
    line-height var(--copy-line-height, 1.5rem)