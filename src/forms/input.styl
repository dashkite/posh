input
  display inline-block
  width 100%
  border-radius 0.5rem
  border 1px solid var(--accent)
  &:invalid
    border 1px solid var(--warning)
  color var(--foreground)    
  background-color var(--background)
  padding-block 0.75rem
  padding-inline-start 0.5rem
  &:focus
    outline none
    border 1px solid var(--accent)

  &:disabled
    opacity 0.5

  font-family var(--monospace-font)

// hack to override chrome's default autofill
// which can't otherwise be overriden (wtf)
// https://issues.chromium.org/issues/40408794#comment77

// this technique adapted from:
// https://codepen.io/team/css-tricks/pen/oxyJxR

input:-webkit-autofill,
input:-webkit-autofill:hover, 
input:-webkit-autofill:focus,
textarea:-webkit-autofill,
textarea:-webkit-autofill:hover,
textarea:-webkit-autofill:focus,
select:-webkit-autofill,
select:-webkit-autofill:hover,
select:-webkit-autofill:focus
  border 1px solid var(--highlight)
  -webkit-text-fill-color var(--highlight)
  -webkit-box-shadow 0 0 0px 1000px #000 inset
  transition background-color 5000s ease-in-out 0s
