select
  // appearance none

  display inline-block
  width 100%
  border-radius 0.5rem
  border 1px solid var(--accent)
  &:invalid
    border 1px solid var(--warning)
  color var(--foreground)    
  background-color var(--background)
  padding-block 0.75rem
  padding-inline-start 0.5rem
  &:focus
    outline none
    border 1px solid var(--accent)

  &:disabled
    opacity 0.5
